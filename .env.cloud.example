# Production settings for Cloud Run (M8, ADR-011). Copy to .env.cloud (git-ignored), fill it in,
# then run: infra/gcp/secrets.sh --project <PROJECT_ID> --env-file .env.cloud
# Everything here goes to Secret Manager; nothing is printed. Leave a line empty to skip it.

# Neon: the *direct* connection string (Connect → turn "Connection pooling" off), Postgres 17,
# region AWS US West 2 (Oregon). Any postgres:// form works; drivers are derived from it.
DATABASE_URL=
# Upstash Redis, region AWS us-west-2 (Oregon): the rediss:// URL from the database page.
REDIS_URL=

# Generated by secrets.sh when empty. ADMIN_TOKEN signs you in to /admin.
SESSION_SECRET=
ADMIN_TOKEN=
PROXY_SECRET=
MCP_AUTH_TOKEN=

# Providers (copy from .env). The API uses the LLM, Cohere, Tavily and YouTube keys; the ingest
# job uses OpenAI and LlamaParse; GitHub Actions evals use the LLM keys and OPENCODE_GO_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=
LLAMA_CLOUD_API_KEY=
OPENCODE_GO_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
