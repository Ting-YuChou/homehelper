# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://homehelper:homehelper@localhost:5432/homehelper
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=
SESSION_SECRET=

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Knowledge ---
LLAMA_CLOUD_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# --- Observability (Langfuse Cloud; tracing is disabled when keys are empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
