# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://homehelper:homehelper@localhost:5432/homehelper
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=
SESSION_SECRET=
# MCP servers (spec §12.1): real | mock; optional bearer token for the mounted /mcp/* endpoints
MCP_MODE=real
MCP_AUTH_TOKEN=
# Agent behind the chat API: stub (scripted, no keys) | journey (needs the KB in Postgres and LLM keys)
AGENT_RUNTIME=stub
# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=100
DAILY_SPEND_CAP_USD=5
LOGIN_RATE_LIMIT_PER_HOUR=20

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenCode Go subscription: eval experiments only, via `opencode_go/<wire>/<model>` overrides
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go

# --- Knowledge ---
LLAMA_CLOUD_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# --- Observability (Langfuse Cloud; tracing is disabled when keys are empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
